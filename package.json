{
  "name": "legacy-hello-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A deliberately outdated React hello-world SPA used to test the React Modernizer agents.",
  "scripts": {
    "start": "vite",
    "start:mock": "vite --mode mock",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "playwright:install": "playwright install --with-deps chromium",
    "playwright:run:smoke": "playwright test --project=Smoke",
    "smoke:check-coverage": "tsx e2e/smoke/utils/smoke-coverage-check.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "axios": "0.27.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "msw": "^2.15.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwind-merge": "^3.7.1",
    "valibot": "^0.42.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/router-devtools": "^1.167.4",
    "@tanstack/router-vite-plugin": "^1.167.49",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/ui": "^5.1.2",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
